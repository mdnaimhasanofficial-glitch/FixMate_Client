# API
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_APP_URL=

# Database (used by BetterAuth inside the Next.js app)
MONGODB_URI=
DB_NAME=

# BetterAuth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# JWT (signs the short-lived API tokens in app/api/token)
# IMPORTANT: this must be the SAME value as JWT_SECRET in fixmate-server/.env
JWT_SECRET=

# ImgBB (profile/service photo upload in app/api/upload)
IMGBB_API_KEY=

# Google OAuth (BetterAuth social login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
